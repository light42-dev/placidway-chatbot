# Copy to .env and fill in. .env is ignored by git.

# The bot's chat endpoint (full URL). Leave empty to run only the self-checks.
BOT_URL=https://your-bot.vercel.app/api/chat

# How many times each conversation is played (consistency needs 2 or more).
RUNS=3

# Slowest acceptable reply, in seconds.
MAX_LATENCY_S=5

# Most tokens (prompt + completion) one reply may use.
MAX_TOKENS_PER_REPLY=3000

# Pause between requests, in seconds, to stay under the provider's per-minute limit.
# Groq's free tier allows 8,000 tokens a minute and a reply uses about 2,000,
# so 16 seconds keeps a run on Groq without falling back to Gemini.
BOT_MIN_INTERVAL_S=16

# Give up on a request after this many seconds.
BOT_TIMEOUT_S=30

# Optional: a unique string placed in the bot's system prompt. If a reply ever
# contains it, the prompt leaked and the turn fails.
SYSTEM_PROMPT_CANARY=

# Set to 0 to compare only check verdicts across runs, not dollar amounts.
CONSISTENCY_AMOUNTS=1

# Keys for the bot itself (not used by the tests). Never commit real values.
GROQ_API_KEY=
GEMINI_API_KEY=
